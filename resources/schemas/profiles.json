{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cloudkit://schemas/profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profiles"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "containerId", "environment", "backend", "authenticationMode", "credentialRef", "allowedScopes"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._:-]+$" },
          "containerId": { "type": "string", "pattern": "^iCloud\\.[A-Za-z0-9.-]+$" },
          "environment": { "enum": ["development", "production"] },
          "backend": { "const": "web-services" },
          "authenticationMode": { "enum": ["server-key", "web-user", "api-token-public"] },
          "credentialRef": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[A-Za-z0-9._:-]+$" },
          "allowedScopes": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "enum": ["public", "private", "shared"] } },
          "recordPolicy": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "allowedTypes": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
              "queryableFields": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
              "readablePayloadFields": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
              "discloseRecordNames": { "type": "boolean", "default": false },
              "discloseZoneNames": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
